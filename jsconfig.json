{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "legacy",
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true
  },
  "include": ["bin/*.js", "lib/*.js", "client/*.js", "client/*.d.ts", "shell/*.js"]
}
