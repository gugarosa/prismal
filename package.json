{
  "name": "prismal",
  "version": "0.1.0",
  "description": "A design lab for agent-proposed UI options: see them live in your real app, pick, and hand the choices back.",
  "type": "module",
  "bin": {
    "prismal": "bin/prismal.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/prismal.js"
  },
  "files": [
    "bin",
    "lib",
    "shell",
    "client",
    "schema",
    "skill"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "npm run lint && npm run lint:docs && npm run check:types && npm run format:check && npm test",
    "verify:browser": "npm run test:e2e && npm run check:example",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:docs": "markdownlint-cli2",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "check:example": "node bin/prismal.js check examples/lumen/prismal.json",
    "check:types": "tsc -p jsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "playwright": ">=1.45"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "markdownlint-cli2": "0.20.0",
    "markdownlint-rule-relative-links": "3.0.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gugarosa/prismal.git"
  },
  "keywords": [
    "design",
    "ui",
    "agents",
    "prototyping",
    "design-review",
    "playwright"
  ]
}
